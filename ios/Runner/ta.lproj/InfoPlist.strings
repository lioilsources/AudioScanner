"NSCameraUsageDescription" = "அறையில் தொலைபேசியின் இடத்தைக் கண்காணிக்க மட்டுமே கேமரா பயன்படுத்தப்படுகிறது (ARKit). படங்கள் எங்கும் சேமிக்கப்படவோ அனுப்பப்படவோ மாட்டாது.";
"NSMicrophoneUsageDescription" = "மைக்ரோஃபோன் அளவீட்டு ஆய்வி: AudioScanner அறையின் ஒலியைப் பிடித்து அதிர்வெண் பதிலைக் கணக்கிடுகிறது. பதிவுகள் உங்கள் தொலைபேசியிலேயே இருக்கும்.";
